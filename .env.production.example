# ==============================================================================
# Namma Connect V2 — Production Environment Template (.env.production.example)
# Real production values MUST be supplied via secrets management (e.g. Vault, GitHub Secrets).
# ==============================================================================

# ── Core Application ──
PROJECT_NAME="Namma Connect"
VERSION="2.0.0"
ENV="production"
DEBUG="False"
API_V2_PREFIX="/api/v2"
FRONTEND_URL="https://nammaconnect.in"

# ── CORS Configuration (Strict Production Domain Origins) ──
CORS_ORIGINS='["https://nammaconnect.in","https://www.nammaconnect.in"]'

# ── Database (PostgreSQL 16 Cluster with pgvector) ──
POSTGRES_USER=namma_user
POSTGRES_PASSWORD=<PRODUCTION_DB_PASSWORD>
POSTGRES_DB=namma_connect_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_SYNC_URL=postgresql://namma_user:<PRODUCTION_DB_PASSWORD>@postgres:5432/namma_connect_prod
DATABASE_URL=postgresql+asyncpg://namma_user:<PRODUCTION_DB_PASSWORD>@postgres:5432/namma_connect_prod

# ── Cache & Background Broker (Redis 7) ──
REDIS_PASSWORD=<PRODUCTION_REDIS_PASSWORD>
REDIS_URL=redis://:<PRODUCTION_REDIS_PASSWORD>@redis:6379/0

# ── Security & Cryptography ──
# Minimum 32 characters required
JWT_SECRET=<STRONG_CRYPTOGRAPHIC_JWT_SECRET_32_PLUS_CHARS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth 2.0 ──
GOOGLE_CLIENT_ID=<PRODUCTION_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<PRODUCTION_GOOGLE_CLIENT_SECRET>

# ── Razorpay Payment Gateway ──
RAZORPAY_KEY_ID=<PRODUCTION_RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<PRODUCTION_RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<PRODUCTION_RAZORPAY_WEBHOOK_SECRET>

# ── Cloudinary Media CDN ──
CLOUDINARY_CLOUD_NAME=<PRODUCTION_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<PRODUCTION_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<PRODUCTION_CLOUDINARY_API_SECRET>

# ── Resend Transactional Email ──
RESEND_API_KEY=<PRODUCTION_RESEND_API_KEY>
RESEND_FROM_EMAIL="notifications@nammaconnect.in"

# ── Google Gemini AI Assistant & Translation ──
GEMINI_API_KEY=<PRODUCTION_GEMINI_API_KEY>
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models"
GEMINI_MODEL="gemini-3.5-flash-lite"

# ── TomTom Maps & Location Services ──
TOMTOM_API_KEY=<PRODUCTION_TOMTOM_API_KEY>
TOMTOM_BASE_URL="https://api.tomtom.com"

# ── Frontend Static Build Arguments ──
VITE_API_URL="/api/v2"
VITE_GOOGLE_CLIENT_ID=<PRODUCTION_GOOGLE_CLIENT_ID>
VITE_TOMTOM_API_KEY=<PRODUCTION_TOMTOM_API_KEY>
