# ==============================================================================
# Namma Connect V2 — Unified Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# Docker Compose will automatically read variables from .env to configure
# PostgreSQL, Redis, FastAPI backend, and frontend proxy.
# ==============================================================================

# Application Core
PROJECT_NAME=Namma Connect
ENV=development
DEBUG=True
API_V2_PREFIX=/api/v2
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Database & Cache Credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Local Host Connection URLs (when running outside Docker)
DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
DATABASE_SYNC_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB

REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT & Argon2id)
JWT_SECRET=namma_connect_v2_development_jwt_secret_key_change_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# External Integrations (Optional for local dev, required for full live third-party flows)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=

GEMINI_API_KEY=
