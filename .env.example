# ==============================================================================
# Namma Connect V2 — Development Environment Template (.env.example)
# Copy this file to .env and fill in real values. Do NOT commit secrets.
# ==============================================================================

# ── Core Application ──
PROJECT_NAME="Namma Connect"
VERSION="2.0.0"
ENV="development"
DEBUG="True"
API_V2_PREFIX="/api/v2"
FRONTEND_URL="http://localhost:5173"

# ── CORS Configuration (JSON array or comma-separated origins) ──
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]'

# ── Database (PostgreSQL 16 with pgvector) ──
POSTGRES_USER=namma_user
POSTGRES_PASSWORD=<REQUIRED_DB_PASSWORD>
POSTGRES_DB=namma_connect_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_SYNC_URL=postgresql://namma_user:<REQUIRED_DB_PASSWORD>@localhost:5432/namma_connect_dev
DATABASE_URL=postgresql+asyncpg://namma_user:<REQUIRED_DB_PASSWORD>@localhost:5432/namma_connect_dev

# ── Cache & Background Broker (Redis 7) ──
REDIS_URL=redis://localhost:6379/0

# ── Security & Cryptography ──
# Minimum 32 characters required in non-test runtime
JWT_SECRET=<REQUIRED_MIN_32_CHAR_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth 2.0 (Optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay Payment Gateway (Optional in dev, required for real checkout) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudinary Media CDN (Optional in dev) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend Transactional Email (Optional in dev) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL="notifications@nammaconnect.in"

# ── Google Gemini AI Assistant & Translation (Optional in dev) ──
GEMINI_API_KEY=
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models"
GEMINI_MODEL="gemini-3.5-flash-lite"

# ── TomTom Maps & Location Services (Optional in dev) ──
TOMTOM_API_KEY=
TOMTOM_BASE_URL="https://api.tomtom.com"

# ── Frontend Configuration ──
VITE_API_URL="http://localhost:8000/api/v2"
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"
VITE_GOOGLE_CLIENT_ID=
VITE_TOMTOM_API_KEY=
